# Service
PORT=8080
LOG_LEVEL=info                              # debug | info | warn | error

# Database
POSTGRES_USER=memory
POSTGRES_PASSWORD=memory
POSTGRES_DB=memory_service
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Reranker — Cohere Rerank API for cross-encoder reranking.
# Optional: if COHERE_API_KEY is empty, retrieval falls back to RRF-only
# ranking. The service will be fully functional but recall quality is
# slightly lower (5-10% per our reference experiments). Higgsfield will
# provide this key for the eval run per the task spec.
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-english-v3.0
COHERE_TIMEOUT_SECONDS=5

# LLM provider (OpenAI) — required for /turns and /recall in later stages.
# Stage 1: service starts without these but logs a warning and reports
# degraded state when LLM-dependent endpoints are called.
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
OPENAI_REPRESENTATION_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Internal timeouts (seconds)
LLM_TIMEOUT_SECONDS=30
EMBEDDING_TIMEOUT_SECONDS=10
