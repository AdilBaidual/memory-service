# Service configuration
PORT=8080
LOG_LEVEL=info                               # debug | info | warn | error

# Database — required
POSTGRES_USER=memory
POSTGRES_PASSWORD=memory
POSTGRES_DB=memory_service
POSTGRES_HOST=postgres                       # container name in docker compose
POSTGRES_PORT=5432

# OpenAI — required for /turns extraction and /recall
# Get a key at https://platform.openai.com
OPENAI_API_KEY=

# Optional: override default models
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
OPENAI_REPRESENTATION_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Cohere — optional, improves retrieval precision via cross-encoder reranking
# Free tier: 1000 calls/month at https://dashboard.cohere.com
# When absent, retrieval falls back to RRF+temporal ordering (fully functional)
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-english-v3.0

# Internal timeouts (seconds)
LLM_TIMEOUT_SECONDS=30
EMBEDDING_TIMEOUT_SECONDS=10
COHERE_TIMEOUT_SECONDS=5
